# Sao chép file này thành backend/.env rồi điền giá trị thật.
# TUYỆT ĐỐI không commit backend/.env và không dán key vào chat/log.
# Sau khi tạo: chmod 600 backend/.env

PROJECT_NAME=DAU Second Brain API
API_V1_STR=/api/v1

# PostgreSQL chỉ chạy trên localhost
DATABASE_URL=postgresql://dau_app:MAT_KHAU_MANH@127.0.0.1:5432/dau_second_brain

# Bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự, ví dụ tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origin frontend, phân tách bằng dấu phẩy. Khi dùng Cloudflare Tunnel cùng hostname
# với API, có thể đặt đúng origin đó, ví dụ: https://dau-test.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.ts.net,https://dau-second-brain.com,https://www.dau-second-brain.com,https://ai-second-brain-dau.vercel.app,https://ai-second-brain-dau-chungcotuan.vercel.app

# --- Chọn backend LLM ---
# "gemini": dùng Gemini native (google.generativeai) - key AIza..., endpoint Google.
# "openai": dùng endpoint tương thích OpenAI (OpenAI-compatible gateway) - hỗ trợ cả
#           chat (RAG) và OCR (vision) qua POST {LLM_BASE_URL}/chat/completions.
LLM_PROVIDER=gemini
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Chatbot RAG
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Model phải còn khả dụng với key của bạn. Kiểm tra bằng endpoint /v1beta/models.
GEMINI_MODEL=gemini-3.6-flash

# OCR qua Gemini API - dùng key RIÊNG, không dùng chung với chatbot.
# OCR_MODEL phải là model có khả năng đọc ảnh mà key của bạn được phép dùng.
# Khi LLM_PROVIDER=openai thì OCR_MODEL là model có vision của gateway đó.
OCR_API_KEY=
OCR_MODEL=gemini-3.6-flash
OCR_TIMEOUT_SECONDS=90
OCR_MAX_PAGES=20
OCR_MAX_PDF_MB=20
OCR_MAX_IMAGE_MB=4
OCR_MAX_RETRIES=2

# Tối ưu tốc độ bóc tách:
# OCR_CONCURRENCY = số trang OCR gửi SONG SONG tới gateway (4 là giá trị đo được, nhanh gấp ~2.3 lần).
# OCR_PAGE_DELAY_SECONDS = nghỉ giữa các đợt OCR (0 = không nghỉ).
# LLM_MAX_CONCURRENT = số request LLM đồng thời tối đa (chat và OCR dùng chung gateway).
OCR_CONCURRENCY=4
OCR_PAGE_DELAY_SECONDS=0
LLM_MAX_CONCURRENT=4

# Giới hạn số trang tối đa cho mọi văn bản (kể cả bản có text layer).
# Vượt giới hạn sẽ bị từ chối ngay lúc tải lên kèm thông báo rõ ràng.
MAX_PAGES_PER_DOCUMENT=100

# Cache mô hình cục bộ (đường dẫn tuyệt đối tới backend/data/models)
HF_HOME=/home/USER/AI_Second_Brain_DAU/backend/data/models
