# Sao chép file này thành backend/.env rồi điền giá trị thật.
# TUYỆT ĐỐI không commit backend/.env và không dán key vào chat/log.
# Sau khi tạo: chmod 600 backend/.env

PROJECT_NAME=DAU Second Brain API
API_V1_STR=/api/v1

# PostgreSQL chỉ chạy trên localhost
DATABASE_URL=postgresql://dau_app:MAT_KHAU_MANH@127.0.0.1:5432/dau_second_brain

# Bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự, ví dụ tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Origin frontend, phân tách bằng dấu phẩy. Khi dùng Cloudflare Tunnel cùng hostname
# với API, có thể đặt đúng origin đó, ví dụ: https://dau-test.example.com
CORS_ORIGINS=http://localhost:5173

# Chatbot RAG
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Model phải còn khả dụng với key của bạn. Kiểm tra bằng endpoint /v1beta/models.
GEMINI_MODEL=gemini-3.6-flash

# OCR qua Gemini API - dùng key RIÊNG, không dùng chung với chatbot.
# OCR_MODEL phải là model có khả năng đọc ảnh mà key của bạn được phép dùng.
OCR_API_KEY=
OCR_MODEL=gemini-3.6-flash
OCR_TIMEOUT_SECONDS=90
OCR_MAX_PAGES=20
OCR_MAX_PDF_MB=20
OCR_MAX_IMAGE_MB=4
OCR_MAX_RETRIES=2

# Cache mô hình cục bộ (đường dẫn tuyệt đối tới backend/data/models)
HF_HOME=/home/USER/AI_Second_Brain_DAU/backend/data/models
